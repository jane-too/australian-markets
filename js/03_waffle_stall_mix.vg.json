{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#F7F4EE",
  "width": 1046,
  "height": 551,
  "padding": {
    "left": 5,
    "top": 5,
    "right": 5,
    "bottom": 4
  },
  "title": {
    "text": "Merchandise fills half the market, and groceries and eateries share the rest",
    "subtitle": [
      "All 150 permanent stalls at South Melbourne Market in 2024-25, one square per",
      "stall. Pop-ups are excluded; services count as merchandise."
    ],
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 22,
    "fontWeight": 600,
    "color": "#1A1A17",
    "subtitleFont": "Archivo",
    "subtitleFontSize": 13.5,
    "subtitleColor": "#6B675F",
    "subtitleLineHeight": 20,
    "offset": 40,
    "subtitlePadding": 10,
    "lineHeight": 29
  },
  "data": {
    "url": "data/stall_mix.csv",
    "format": {
      "type": "csv",
      "parse": {
        "stalls": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.market == 'South Melbourne Market'"
    },
    {
      "filter": "datum.category != 'SO:ME Space pop-up'"
    },
    {
      "calculate": "datum.category == 'General merchandise' || datum.category == 'Services' ? 'General merchandise & services' : datum.category",
      "as": "trade"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "stalls",
          "as": "stalls"
        }
      ],
      "groupby": [
        "trade"
      ]
    },
    {
      "calculate": "datum.trade == 'Grocery' ? 0 : datum.trade == 'Eateries' ? 1 : 2",
      "as": "panel"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "stalls",
          "as": "total"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "stalls",
          "as": "lo"
        }
      ]
    },
    {
      "calculate": "datum.stalls / datum.total * 100",
      "as": "share_pct"
    },
    {
      "calculate": "datum.panel * 13",
      "as": "panel_x"
    },
    {
      "calculate": "sequence(0, datum.total)",
      "as": "unit"
    },
    {
      "flatten": [
        "unit"
      ]
    },
    {
      "calculate": "datum.unit < datum.stalls",
      "as": "filled"
    },
    {
      "calculate": "datum.panel_x + datum.unit % 10",
      "as": "x"
    },
    {
      "calculate": "floor(datum.unit / 10)",
      "as": "y"
    }
  ],
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "axis": null,
      "title": null,
      "scale": {
        "domain": [
          -0.5,
          35.5
        ]
      }
    },
    "y": {
      "field": "y",
      "type": "quantitative",
      "axis": null,
      "title": null,
      "scale": {
        "domain": [
          17.66,
          -0.5
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 568,
        "opacity": 1,
        "tooltip": {
          "expr": "{'Trade': datum.trade, 'Stalls': datum.stalls + ' of ' + datum.total + ' (' + format(datum.share_pct, '.1f') + '%' + ')'}"
        }
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.filled",
            "value": "#A07C0A"
          },
          "value": "#DDDDDD"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.unit == 0"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#FCFBF8",
        "stroke": "#DFD9CC",
        "strokeWidth": 1,
        "cornerRadius": 2,
        "xOffset": -12,
        "x2Offset": 274,
        "yOffset": 24,
        "y2Offset": 109
      },
      "encoding": {
        "x": {
          "field": "panel_x",
          "type": "quantitative"
        },
        "x2": {
          "field": "panel_x"
        },
        "y": {
          "datum": 14
        },
        "y2": {
          "datum": 14
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.unit == 0"
        },
        {
          "calculate": "datum.trade == 'Grocery' ? 'Groceries' : datum.trade",
          "as": "heading"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 3,
        "dy": 36,
        "font": "Archivo",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#2E2A24"
      },
      "encoding": {
        "x": {
          "field": "panel_x",
          "type": "quantitative"
        },
        "y": {
          "datum": 14
        },
        "text": {
          "field": "heading",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.unit == 0"
        },
        {
          "calculate": "split(datum.trade == 'Grocery' ? 'Grocers run ' + datum.stalls + ' stalls,|' + format(datum.share_pct, '.0f') + '% of the market.' : datum.stalls == datum.lo ? datum.trade + ' are the smallest trade,|with ' + datum.stalls + ' stalls (' + format(datum.share_pct, '.0f') + '%).' : datum.stalls > datum.total - datum.stalls ? 'Its ' + datum.stalls + ' stalls (' + format(datum.share_pct, '.0f') + '%) outnumber the|other two trades combined.' : 'It holds ' + datum.stalls + ' stalls,|' + format(datum.share_pct, '.0f') + '% of the market.', '|')",
          "as": "line1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 3,
        "dy": 61,
        "font": "Archivo",
        "fontSize": 14.5,
        "fontWeight": 400,
        "color": "#2E2A24",
        "lineHeight": 19
      },
      "encoding": {
        "x": {
          "field": "panel_x",
          "type": "quantitative"
        },
        "y": {
          "datum": 14
        },
        "text": {
          "field": "line1",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#F7F4EE"
  }
}
