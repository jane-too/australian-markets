    },
    {
      "data": {
        "url": "data/daytrips_markets_share_by_state.csv",
        "format": {
          "type": "csv",
          "parse": {
            "share_pct": "number",
            "reliable": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.reliable == 1"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "share_pct",
              "as": "hi"
            },
            {
              "op": "min",
              "field": "share_pct",
              "as": "lo"
            }
          ]
        },
        {
          "window": [
            {
              "op": "first_value",
              "field": "state",
              "as": "hi_state"
            }
          ],
          "sort": [
            {
              "field": "share_pct",
              "order": "descending"
            }
          ],
          "frame": [
            null,
            null
          ]
        },
        {
          "window": [
            {
              "op": "first_value",
              "field": "state",
              "as": "lo_state"
            }
          ],
          "sort": [
            {
              "field": "share_pct",
              "order": "ascending"
            }
          ],
          "frame": [
            null,
            null
          ]
        },
        {
          "filter": "datum.share_pct == datum.hi"
        },
        {
          "calculate": "split('The highest and lowest states differ|by ' + format(datum.hi - datum.lo, '.2f') + ' percentage points.', '|')",
          "as": "claim"
        },
        {
          "calculate": "datum.hi_state + ' ' + format(datum.hi, '.2f') + '%, ' + datum.lo_state + ' ' + format(datum.lo, '.2f') + '%.'",
          "as": "figures"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": -125.0,
        "dy": -29.0,
        "font": "Archivo",
        "fontSize": 14,
        "fontWeight": 600,
        "color": "#2E2A24",
        "lineHeight": 18
      },
      "encoding": {
        "longitude": {
          "datum": 125.0
        },
        "latitude": {
          "datum": -40.75
        },
        "text": {
          "field": "claim",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/daytrips_markets_share_by_state.csv",
