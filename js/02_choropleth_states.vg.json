{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 600,
  "background": "#F7F4EE",
  "padding": {
    "left": 5,
    "top": 5,
    "right": 5,
    "bottom": 2
