  "title": {
    "text": "Markets draw a steady slice of day trips, wherever you are",
    "subtitle": [
      "Share of day trips that included a market, 2022–24 combined. Some states rest on",
      "few survey responses: Tasmania’s on 51, against a minimum of 40."
    ],
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 22,
    "fontWeight": 600,
    "color": "#1A1A17",
    "subtitleFont": "Archivo",
    "subtitleFontSize": 13.5,
    "subtitleColor": "#6B675F",
    "subtitleLineHeight": 20,
    "offset": 41,
    "subtitlePadding": 10,
    "lineHeight": 29
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states_abs2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#DAD5CA",
        "stroke": "#F7F4EE",
        "strokeWidth": 1.4
      }
    },
    {
      "data": {
        "url": "data/daytrips_markets_share_by_state.csv"
      },
      "transform": [
        {
          "filter": "datum.reliable == 1"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/au_states_abs2021.topojson",
              "format": {
                "type": "topojson",
                "feature": "STE_2021_AUST_GDA2020"
              }
            },
            "key": "properties.STE_NAME21"
          },
          "as": "geo"
        },
        {
          "calculate": "datum.share_pct < 2.6 ? 'Under 2.6%' : datum.share_pct < 2.9 ? '2.6–2.9%' : datum.share_pct < 3.2 ? '2.9–3.2%' : '3.2% or more'",
          "as": "share_class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#F7F4EE",
        "strokeWidth": 1.4,
        "tooltip": {
          "expr": "{'State': datum.state, 'Share of day trips': format(datum.share_pct, '.1f') + '%', 'Survey responses': format(datum.sample, ',.0f')}"
        }
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "share_class",
          "type": "ordinal",
          "title": [
            "Share of day trips",
            "including a market"
          ],
          "scale": {
            "domain": [
              "3.2% or more",
              "2.9–3.2%",
              "2.6–2.9%",
              "Under 2.6%"
            ],
            "range": [
              "#1B867C",
              "#54B3A9",
              "#9BD4CD",
              "#D6EBE8"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 0,
            "legendY": 221,
            "direction": "vertical",
            "labelFont": "Archivo",
            "labelFontSize": 12.5,
            "labelColor": "#2E2A24",
            "titleFont": "Archivo",
            "titleFontSize": 13.5,
            "titleColor": "#2E2A24",
            "titleLineHeight": 18,
            "titleLimit": 200,
            "symbolType": "square",
            "symbolSize": 484,
            "symbolStrokeWidth": 0,
            "rowPadding": 8,
            "labelOffset": 10,
            "titleFontWeight": 600,
            "titlePadding": 10
          }
        }
      }
    },
    {
