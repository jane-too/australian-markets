        "format": {
          "type": "csv",
          "parse": {
            "sample": "number",
            "reliable": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.reliable == 0"
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "sample",
              "as": "lo"
            },
            {
              "op": "max",
              "field": "sample",
              "as": "hi"
            }
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "n"
            }
          ]
        },
        {
          "filter": "datum.n == 1"
        },
        {
          "calculate": "split('The Northern Territory and|the ACT are unshaded.', '|')",
          "as": "claim"
        },
        {
          "calculate": "datum.lo == datum.hi ? split('Only ' + datum.lo + ' survey responses in each|territory included a market day trip.', '|') : split('Only ' + datum.lo + ' and ' + datum.hi + ' survey responses|included a market day trip.', '|')",
          "as": "figures"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "lineHeight": 18,
        "dy": -36.0,
