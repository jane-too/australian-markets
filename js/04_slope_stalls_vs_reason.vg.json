{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#F7F4EE",
  "padding": {
    "left": 5,
    "top": 5,
    "right": 5,
    "bottom": 4
  },
  "width": "container",
  "height": 440,
  "title": {
    "text": "The trade that fills the most stalls is the main draw for only 6% of visitors",
    "subtitle": [
      "Each trade’s share of South Melbourne Market’s stalls, against the share of visitors",
      "who come mainly for it. Both from the market’s 2026 plan."
    ],
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 22,
    "fontWeight": 600,
    "color": "#1A1A17",
    "subtitleFont": "Archivo",
    "subtitleFontSize": 13.5,
    "subtitleColor": "#6B675F",
    "subtitleLineHeight": 20,
    "offset": 38,
    "subtitlePadding": 10,
    "lineHeight": 29
  },
  "data": {
    "url": "data/smm_stalls_vs_reason.csv",
    "format": {
      "type": "csv",
      "parse": {
        "share_of_stalls_pct": "number",
        "main_reason_pct": "number"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "share_of_stalls_pct",
        "main_reason_pct"
      ],
      "as": [
        "measure",
        "pct"
      ]
    },
    {
      "calculate": "datum.measure == 'share_of_stalls_pct' ? 0 : 1",
      "as": "xpos"
    },
    {
      "calculate": "datum.category == 'Grocery' ? 'Groceries' : datum.category",
      "as": "display"
    },
    {
      "calculate": "datum.category == 'Grocery'",
      "as": "is_figure"
    },
    {
      "calculate": "datum.category == 'General merchandise & services'",
      "as": "is_merch"
    }
  ],
  "encoding": {
    "x": {
      "field": "xpos",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -1.1,
          2.1
        ]
      }
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          78
        ]
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "!datum.is_merch"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#B38E18",
        "strokeWidth": 2.5,
        "strokeCap": "round"
      },
      "encoding": {
        "detail": {
          "field": "category"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_merch"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#B38E18",
        "strokeWidth": 5,
        "strokeCap": "round"
      },
      "encoding": {
        "detail": {
          "field": "category"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 1,
        "color": "#B38E18",
        "tooltip": {
          "expr": "datum.measure == 'share_of_stalls_pct' ? {'Trade': datum.display, 'Share of stalls': format(datum.pct, '.0f') + '%'} : {'Trade': datum.display, 'Main reason for visiting': format(datum.pct, '.0f') + '%'}"
        }
      },
      "encoding": {
        "size": {
          "condition": {
            "test": "datum.is_merch",
            "value": 160
          },
          "value": 80
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "xpos": 0,
            "pct": 76,
            "h": "Share of stalls"
          },
          {
            "xpos": 1,
            "pct": 76,
            "h": "Main reason for visiting"
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "font": "Archivo",
        "fontSize": 14,
        "fontWeight": 600,
        "color": "#2E2A24",
        "baseline": "middle"
      },
      "encoding": {
        "text": {
          "field": "h"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.xpos == 0"
        },
        {
          "calculate": "format(datum.pct, '.0f') + '%'",
          "as": "v"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -16,
        "font": "Archivo",
        "fontSize": 15,
        "fontWeight": {
          "expr": "datum.is_merch ? 600 : 400"
        },
        "color": "#2E2A24"
      },
      "encoding": {
        "text": {
          "field": "v"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.xpos == 1"
        },
        {
          "calculate": "format(datum.pct, '.0f') + '%'",
          "as": "v"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 16,
        "font": "Archivo",
        "fontSize": 15,
        "fontWeight": {
          "expr": "datum.is_merch ? 600 : 400"
        },
        "color": "#2E2A24"
      },
      "encoding": {
        "text": {
          "field": "v"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.xpos == 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -58,
        "font": "Archivo",
        "fontSize": 14,
        "color": "#2E2A24",
        "fontWeight": 400
      },
      "encoding": {
        "text": {
          "field": "display"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.xpos == 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 58,
        "font": "Archivo",
        "fontSize": 14,
        "color": "#2E2A24",
        "fontWeight": 400
      },
      "encoding": {
        "text": {
          "field": "display"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_figure && datum.xpos == 1"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#FCFBF8",
        "stroke": "#DFD9CC",
        "strokeWidth": 1,
        "cornerRadius": 2,
        "xOffset": 58,
        "x2Offset": 236.2,
        "yOffset": 18,
        "y2Offset": 68
      },
      "encoding": {
        "x": {
          "datum": 1
        },
        "x2": {
          "datum": 1
        },
        "y": {
          "datum": 61
        },
        "y2": {
          "datum": 61
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_figure && datum.xpos == 1"
        },
        {
          "calculate": "split('More than 3 visitors in 5|come mainly for groceries.', '|')",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "lineHeight": 18,
        "font": "Archivo",
        "fontSize": 13.5,
        "fontWeight": 300,
        "color": "#2E2A24",
        "dx": 70,
        "dy": 26
      },
      "encoding": {
        "x": {
          "datum": 1
        },
        "y": {
          "datum": 61
        },
        "text": {
          "field": "note"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_merch && datum.xpos == 1"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#FCFBF8",
        "stroke": "#DFD9CC",
        "strokeWidth": 1,
        "cornerRadius": 2,
        "xOffset": 58,
        "x2Offset": 247.4,
        "yOffset": 18,
        "y2Offset": 86
      },
      "encoding": {
        "x": {
          "datum": 1
        },
        "x2": {
          "datum": 1
        },
        "y": {
          "datum": 6
        },
        "y2": {
          "datum": 6
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_merch && datum.xpos == 1"
        },
        {
          "calculate": "split('It fills half the market’s stalls,|yet only ' + format(datum.pct, '.0f') + ' visitors in 100|come primarily for it.', '|')",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "lineHeight": 18,
        "font": "Archivo",
        "fontSize": 13.5,
        "fontWeight": 300,
        "color": "#2E2A24",
        "dx": 70,
        "dy": 26
      },
      "encoding": {
        "x": {
          "datum": 1
        },
        "y": {
          "datum": 6
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#F7F4EE"
  }
}
