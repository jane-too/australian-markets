{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#F7F4EE",
  "padding": {
    "left": 5,
    "top": 5,
    "right": 5,
    "bottom": 3
  },
  "title": {
    "text": [
      "Over the same five years South Melbourne Market ended 7% above where it began;",
      "Queen Victoria Market ended slightly below"
    ],
    "subtitle": [
      "Visitors by financial year; each bar is the change from the year before. FY2019-20",
      "already includes four months of the pandemic."
    ],
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 22,
    "fontWeight": 600,
    "color": "#1A1A17",
    "subtitleFont": "Archivo",
    "subtitleFontSize": 13.5,
    "subtitleColor": "#6B675F",
    "subtitleLineHeight": 20,
    "offset": 43,
    "lineHeight": 29,
    "subtitlePadding": 10
  },
  "hconcat": [
    {
      "title": {
        "text": "Queen Victoria Market",
        "subtitle": "Day Market visitors",
        "anchor": "start",
        "font": "Archivo",
        "fontSize": 15,
        "fontWeight": 600,
        "color": "#2E2A24",
        "offset": 10,
        "subtitleFont": "Archivo",
        "subtitleFontSize": 13.5,
        "subtitleColor": "#6B675F",
        "subtitlePadding": 4
      },
      "width": 479,
      "height": 430,
      "layer": [
        {
          "data": {
            "url": "data/market_visitors_by_year.csv",
            "format": {
              "type": "csv",
              "parse": {
                "visitors": "number"
              }
            }
          },
          "mark": {
            "type": "rule",
            "stroke": "#B9B2A5",
            "strokeWidth": 1,
            "strokeDash": [
              2,
              2
            ],
            "xOffset": 19,
            "x2Offset": -19
          },
          "encoding": {
            "x": {
              "field": "fy",
              "type": "ordinal",
              "sort": [
                "2019-20",
                "2020-21",
                "2021-22",
                "2022-23",
                "2023-24",
                "  2023-24 total"
              ],
              "title": null
            },
            "x2": {
              "field": "fy2"
            },
            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  8600000
                ]
              }
            }
          },
          "transform": [
            {
              "filter": "datum.market == 'Queen Victoria Market' && datum.financial_year >= '2019-20' && datum.financial_year <= '2023-24'"
            },
            {
              "window": [
                {
                  "op": "lead",
                  "field": "financial_year",
                  "as": "fy2"
                }
              ],
              "sort": [
                {
                  "field": "financial_year",
                  "order": "ascending"
                }
              ]
            },
            {
              "filter": "isValid(datum.fy2)"
            },
            {
              "calculate": "datum.financial_year",
              "as": "fy"
            },
            {
              "calculate": "datum.visitors",
              "as": "y"
            }
          ]
        },
        {
          "data": {
            "url": "data/market_visitors_by_year.csv",
            "format": {
              "type": "csv",
              "parse": {
                "visitors": "number"
              }
            }
          },
          "mark": {
            "type": "bar",
            "size": 36,
            "cornerRadius": 1,
            "tooltip": {
              "expr": "isValid(datum.delta) && datum.copy != 1 ? {'Year': trim(datum.fy), 'Visitors': format(datum.total, ',.0f'), 'Change on previous year': (datum.delta > 0 ? '+' : '−') + format(abs(datum.delta), ',.0f')} : {'Year': trim(replace(datum.fy, 'total', '')), 'Visitors': format(datum.total, ',.0f')}"
            }
          },
          "encoding": {
            "x": {
              "field": "fy",
              "type": "ordinal",
              "sort": [
                "2019-20",
                "2020-21",
                "2021-22",
                "2022-23",
                "2023-24",
                "  2023-24 total"
              ],
              "title": null,
              "axis": {
                "labelFont": "Archivo",
                "labelFontSize": 12.5,
                "labelColor": "#6B675F",
                "labelAngle": 0,
                "domain": false,
                "ticks": false,
                "labelPadding": 8,
                "labelAlign": "center",
                "labelOffset": 0
              }
            },
            "y": {
              "field": "lo",
              "type": "quantitative",
              "title": null,
              "scale": {
                "domain": [
                  0,
                  8600000
                ]
              },
              "axis": {
                "labelFont": "Archivo",
                "labelFontSize": 12.5,
                "labelColor": "#6B675F",
                "format": "~s",
                "domain": false,
                "ticks": false,
                "grid": true,
                "gridColor": "#E8E4DC",
                "labelPadding": 6,
                "values": [
                  0,
                  2000000,
                  4000000,
                  6000000,
                  8000000
                ]
              }
            },
            "y2": {
              "field": "hi"
            },
            "color": {
              "value": "#A632A6"
            }
          },
          "transform": [
            {
              "filter": "datum.market == 'Queen Victoria Market' && datum.financial_year >= '2019-20' && datum.financial_year <= '2023-24'"
            },
            {
              "window": [
                {
                  "op": "lag",
                  "field": "visitors",
                  "as": "prev"
                }
              ],
              "sort": [
                {
                  "field": "financial_year",
                  "order": "ascending"
                }
              ]
            },
            {
              "calculate": "datum.financial_year",
              "as": "fy"
            },
            {
              "calculate": "datum.visitors",
              "as": "total"
            },
            {
              "calculate": "isValid(datum.prev) ? datum.visitors - datum.prev : null",
              "as": "delta"
            },
            {
              "calculate": "datum.status == 'C'",
              "as": "est"
            },
            {
              "calculate": "datum.est && isValid(datum.delta) && abs(datum.delta) < 50000",
              "as": "nil"
            },
            {
              "calculate": "!isValid(datum.prev) ? 'total' : (datum.delta > 0 ? 'up' : 'down')",
              "as": "kind"
            },
            {
              "calculate": "!isValid(datum.prev) ? 0 : (datum.nil ? datum.visitors - 70000 : min(datum.prev, datum.visitors))",
              "as": "lo"
            },
            {
              "calculate": "!isValid(datum.prev) ? datum.visitors : (datum.nil ? datum.visitors + 70000 : max(datum.prev, datum.visitors))",
              "as": "hi"
            },
            {
              "calculate": "!isValid(datum.prev) ? format(datum.visitors / 1e6, '.2f') + 'M' : (datum.nil ? 'Unchanged' : (datum.delta > 0 ? '+' : '−') + format(abs(datum.delta) / 1e6, '.2f') + 'M')",
              "as": "lab"
            },
            {
              "calculate": "datum.fy == '2023-24' ? [0, 1] : [0]",
              "as": "copy"
            },
            {
              "flatten": [
                "copy"
              ]
            },
            {
              "calculate": "datum.copy == 1 ? '  2023-24 total' : datum.fy",
              "as": "fy"
            },
            {
              "calculate": "datum.copy == 1 ? 0 : datum.lo",
              "as": "lo"
            },
            {
              "calculate": "datum.copy == 1 ? datum.visitors : datum.hi",
              "as": "hi"
            },
            {
              "calculate": "datum.copy == 1 ? 'total' : datum.kind",
              "as": "kind"
            },
            {
              "calculate": "datum.copy == 1 ? null : datum.delta",
              "as": "delta"
            },
            {
              "calculate": "datum.copy == 1 ? false : datum.est",
              "as": "est"
            },
            {
              "calculate": "datum.copy == 1 ? format(datum.visitors / 1e6, '.2f') + 'M' : datum.lab",
              "as": "lab"
            },
            {
              "calculate": "datum.est ? 'Estimate, derived from a later annual report' : 'Published count'",
              "as": "basis"
            }
          ]
        },
