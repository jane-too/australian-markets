            "labelFont": "Archivo",
            "labelFontSize": 12.5,
            "labelColor": "#6B675F",
            "domain": false,
            "ticks": false,
            "grid": true,
            "gridColor": "#E8E4DC",
            "gridWidth": 1,
            "labelPadding": 8
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "QVM area",
              "Other CBD",
              "South Melbourne Market"
            ],
            "range": [
              "#A632A6",
              "#9A948A",
              "#2F6B45"
            ]
