{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#F7F4EE",
  "width": 852,
  "height": {
    "step": 115
  },
  "padding": 5,
  "title": {
    "text": "Queen Victoria Market’s streets and the city centre emptied together, then came apart",
    "subtitle": [
      "Change in foot traffic in each month of 2020 against the same month a year earlier.",
      "Gaps between the two sensor series are given in percentage points."
    ],
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 22,
    "fontWeight": 600,
    "color": "#1A1A17",
    "subtitleFont": "Archivo",
    "subtitleFontSize": 13.5,
    "subtitleColor": "#6B675F",
    "subtitleLineHeight": 20,
    "offset": 42,
    "subtitlePadding": 10,
    "lineHeight": 29
  },
  "encoding": {
    "y": {
      "field": "month",
      "type": "nominal",
      "sort": [
        "March",
        "April",
        "May",
        "June"
      ],
      "title": null,
      "axis": {
        "labelFont": "Archivo",
        "labelFontSize": 12.5,
        "labelColor": "#2E2A24",
        "labelPadding": 56,
        "domain": false,
        "ticks": false,
        "labelAngle": 0,
        "labelAlign": "left"
      }
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/covid_monthly_change_by_group.csv",
        "format": {
          "type": "csv",
          "parse": {
            "counts_2019": "number",
            "counts_2020": "number",
            "pct_change": "number"
          }
        }
      },
      "transform": [
        {
          "pivot": "group",
          "value": "pct_change",
          "groupby": [
            "month"
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#9A948A",
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      "encoding": {
        "x": {
          "field": "QVM area",
          "type": "quantitative",
          "scale": {
            "domain": [
              -90,
              0
            ]
          },
          "title": null,
          "axis": {
            "orient": "top",
            "values": [
              -90,
              -75,
              -60,
              -45,
              -30,
              -15,
              0
            ],
            "labelExpr": "replace(datum.value + '%', '-', '−')",
            "labelFont": "Archivo",
            "labelFontSize": 12.5,
            "labelColor": "#6B675F",
            "domain": false,
            "ticks": false,
            "grid": true,
            "gridColor": "#E8E4DC",
            "gridWidth": 1,
            "labelPadding": 8
          }
        },
        "x2": {
          "field": "Other CBD"
        }
      }
    },
    {
      "data": {
        "url": "data/covid_monthly_change_by_group.csv",
        "format": {
          "type": "csv",
          "parse": {
            "counts_2019": "number",
            "counts_2020": "number",
            "pct_change": "number"
          }
        }
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 300,
        "opacity": 1,
        "strokeWidth": 0,
        "tooltip": {
          "expr": "{'title': (datum.group == 'QVM area' ? 'Streets around Queen Victoria Market' : datum.group == 'Other CBD' ? 'Rest of the city centre' : datum.group), 'Month': datum.month, 'Change on 2019': (datum.pct_change > 0 ? '+' : '−') + format(abs(datum.pct_change), '.1f') + '%', 'People counted, 2020': format(datum.counts_2020, ',.0f')}"
        }
      },
      "encoding": {
        "x": {
          "field": "pct_change",
          "type": "quantitative",
          "scale": {
            "domain": [
              -90,
              0
            ]
          },
          "title": null,
          "axis": {
            "orient": "top",
