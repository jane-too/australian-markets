          "parse": {
            "counts_2019": "number",
            "counts_2020": "number",
            "pct_change": "number",
            "latitude": "number",
            "longitude": "number",
            "mappable": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.mappable == 1 && datum.group != 'QVM area'"
        },
        {
          "calculate": "100 + datum.pct_change",
          "as": "stayed"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#9A948A",
        "strokeWidth": 1.1,
        "stroke": "#6B675F",
        "opacity": 0.75,
        "tooltip": {
          "expr": "{'Sensor': datum.sensor_name, 'Crowd remaining': format(datum.stayed, '.1f') + '%', 'People counted, Mar–Jun 2019': format(datum.counts_2019, ',.0f'), 'People counted, Mar–Jun 2020': format(datum.counts_2020, ',.0f')}"
        }
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "stayed",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              65
            ],
            "range": [
              0,
              1300
            ]
          },
          "legend": null
        }
      }
    },
