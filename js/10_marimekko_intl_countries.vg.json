{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#F7F4EE",
  "padding": 5,
  "width": 982,
  "height": 600,
  "title": {
    "text": "Australia’s most numerous visitors are its least likely market-goers",
    "subtitle": [
      "International visitors in 2025 by country. Column width is the number of visitors; bar",
      "height is the share who visited a market."
    ],
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 22,
    "fontWeight": 600,
    "color": "#1A1A17",
    "subtitleFont": "Archivo",
    "subtitleFontSize": 13.5,
    "subtitleColor": "#6B675F",
    "subtitleLineHeight": 20,
    "offset": 11,
    "subtitlePadding": 10,
    "lineHeight": 29
  },
  "data": {
    "url": "data/intl_visitors_by_country_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "visitors": "number",
        "mkt_visitors": "number",
        "mkt_share_pct": "number",
        "sample": "number",
        "mkt_sample": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year == '2025' && datum.mkt_reliable == '1' && datum.imputed_2020_22 != '1'"
    },
    {
      "calculate": "datum.country == 'United States of America' ? 'United States' : indexof(datum.country, 'Other Asia') == 0 ? 'Other Asia' : datum.country",
      "as": "name"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "visitors",
          "as": "x1"
        }
      ],
      "sort": [
        {
          "field": "mkt_share_pct",
          "order": "descending"
        },
        {
          "field": "country",
          "order": "ascending"
        }
      ],
      "frame": [
        null,
        0
      ],
      "ignorePeers": true
    },
    {
      "calculate": "datum.x1 - datum.visitors",
      "as": "x0"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "xm"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "visitors",
          "as": "total_v"
        },
        {
          "op": "sum",
          "field": "mkt_visitors",
          "as": "total_m"
        }
      ]
    },
    {
      "calculate": "datum.total_m / datum.total_v * 100",
      "as": "overall"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "fill": "#DDDDDD",
        "stroke": "#F7F4EE",
        "strokeWidth": 1,
        "tooltip": {
          "expr": "{'Country': datum.country, 'Visitors': format(datum.visitors, ',.0f'), 'Went to a market': format(datum.mkt_visitors, ',.0f') + ' (' + format(datum.mkt_share_pct, '.1f') + '%' + ')'}"
        }
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8272331
            ],
            "nice": false,
            "zero": true
          },
          "title": null,
          "axis": {
            "values": [
              0,
              2000000,
              4000000,
              6000000,
              8000000
            ],
            "labelExpr": "datum.value == 0 ? '0' : format(datum.value/1e6, '.0f') + 'M'",
            "labelFont": "Archivo",
            "labelFontSize": 12.5,
            "labelColor": "#6B675F",
            "domain": false,
            "ticks": false,
            "grid": false,
            "labelPadding": 8,
            "title": "International visitors in 2025, column width",
            "titleFont": "Archivo",
            "titleFontSize": 12.5,
            "titleFontWeight": 400,
            "titleColor": "#6B675F",
            "titlePadding": 8
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "mkt_share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              126
            ]
          },
          "title": null,
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'",
            "labelFont": "Archivo",
            "labelFontSize": 12.5,
            "labelColor": "#6B675F",
            "domain": false,
            "ticks": false,
            "grid": false,
            "labelPadding": 6,
            "title": "Share of visitors who went to a market",
            "titleFont": "Archivo",
            "titleFontSize": 12.5,
            "titleFontWeight": 400,
            "titleColor": "#6B675F",
            "titlePadding": 10,
            "titleY": 368.9,
            "titleAlign": "center",
            "titleAngle": -90
          }
        },
        "y2": {
          "datum": 100
        }
      }
    },
    {
      "mark": {
        "type": "rect",
        "fill": "#B38E18",
        "stroke": "#F7F4EE",
        "strokeWidth": 1,
        "tooltip": {
          "expr": "{'Country': datum.country, 'Visitors': format(datum.visitors, ',.0f'), 'Went to a market': format(datum.mkt_visitors, ',.0f') + ' (' + format(datum.mkt_share_pct, '.1f') + '%' + ')'}"
        }
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative"
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "mkt_share_pct",
          "type": "quantitative"
        },
        "y2": {
          "datum": 0
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "overall",
              "as": "overall"
            }
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#F7F4EE",
        "strokeWidth": 1.5,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "y": {
          "field": "overall",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "overall",
              "as": "overall"
            },
            {
              "op": "max",
              "field": "total_v",
              "as": "tv"
            }
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -6,
        "dy": -4,
        "font": "Archivo",
        "fontSize": 12,
        "color": "#2E2A24"
      },
      "encoding": {
        "x": {
          "field": "tv",
          "type": "quantitative"
        },
        "y": {
          "field": "overall",
          "type": "quantitative"
        },
        "text": {
          "value": {
            "expr": "'All visitors: ' + format(datum.overall, '.1f') + '%'"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.visitors / datum.total_v >= 0.0145"
        }
      ],
      "mark": {
        "type": "text",
        "angle": 270,
        "align": "right",
        "baseline": "middle",
        "dy": 0,
        "dx": -6,
        "font": "Archivo",
        "fontSize": 11.5,
        "color": "#2E2A24"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 100,
          "type": "quantitative"
        },
        "text": {
          "field": "name"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'Taiwan'"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#A39C8E",
        "strokeWidth": 1,
        "y2Offset": -1
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 123,
          "type": "quantitative"
        },
        "y2": {
          "datum": 100
        },
        "yOffset": {
          "value": 51
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'Taiwan'"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#FCFBF8",
        "stroke": "#DFD9CC",
        "strokeWidth": 1,
        "cornerRadius": 2,
        "xOffset": -14,
        "x2Offset": 238,
        "yOffset": 0,
        "y2Offset": 53
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "x2": {
          "field": "xm"
        },
        "y": {
          "datum": 123,
          "type": "quantitative"
        },
        "y2": {
          "datum": 123
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'Taiwan'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "font": "Archivo",
        "fontSize": 12.5,
        "color": "#2E2A24",
        "lineHeight": 17,
        "dx": -1,
        "dy": 11,
        "text": [
          "Visitors from Taiwan are the most likely",
          "to go: 67.7% of 174,946 went to a market."
        ]
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 123,
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'New Zealand'"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#A39C8E",
        "strokeWidth": 1,
        "y2Offset": -1
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 123,
          "type": "quantitative"
        },
        "y2": {
          "datum": 100
        },
        "yOffset": {
          "value": 68
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'New Zealand'"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#FCFBF8",
        "stroke": "#DFD9CC",
        "strokeWidth": 1,
        "cornerRadius": 2,
        "xOffset": -214,
        "x2Offset": 14,
        "yOffset": 0,
        "y2Offset": 70
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "x2": {
          "field": "xm"
        },
        "y": {
          "datum": 123,
          "type": "quantitative"
        },
        "y2": {
          "datum": 123
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'New Zealand'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "font": "Archivo",
        "fontSize": 12.5,
        "color": "#2E2A24",
        "lineHeight": 17,
        "dx": -201,
        "dy": 11,
        "text": [
          "A low share of a big number: 30% of",
          "1.3 million is 390,477 people, second",
          "only to China."
        ]
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 123,
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#F7F4EE"
  }
}
